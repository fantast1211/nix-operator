{
    "$schema": "http://json-schema.org/draft-04/schema#",
    "$ref": "#/definitions/NetworkConfigurationSpec",
    "definitions": {
        "NetworkConfigurationSpec": {
            "properties": {
                "node_selector": {
                    "$ref": "#/definitions/api.system.v1.NodeSelector",
                    "additionalProperties": true,
                    "description": "节点选择器（用于定位目标节点）"
                },
                "interfaces": {
                    "items": {
                        "$ref": "#/definitions/api.system.v1.NetworkInterface"
                    },
                    "type": "array",
                    "description": "网络接口列表"
                }
            },
            "additionalProperties": true,
            "type": "object",
            "title": "网络相关配置定义",
            "description": "网络相关配置定义  多接口网络配置项"
        },
        "api.system.v1.BondingSlaveConfig": {
            "properties": {
                "enabled": {
                    "type": "boolean",
                    "description": "启用 bond 从属模式"
                },
                "master": {
                    "type": "string",
                    "description": "所属 bond 接口名（如 bond0）"
                }
            },
            "additionalProperties": true,
            "type": "object",
            "title": "Bonding Slave Config",
            "description": "网卡作为 bond 从属配置"
        },
        "api.system.v1.NetworkInterface": {
            "properties": {
                "name": {
                    "type": "string",
                    "description": "接口名称（如 eth0, enp0s3）"
                },
                "ipv4_address": {
                    "pattern": "^((25[0-5]|2[0-4][0-9]|[01]?[0-9]?[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9]?[0-9])$",
                    "type": "string",
                    "description": "IPv4 地址"
                },
                "ipv6_address": {
                    "pattern": "^[0-9a-fA-F:]{2,39}$",
                    "type": "string",
                    "description": "IPv6 地址"
                },
                "ipv4_gateway": {
                    "pattern": "^((25[0-5]|2[0-4][0-9]|[01]?[0-9]?[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9]?[0-9])$",
                    "type": "string",
                    "description": "IPv4 网关"
                },
                "ipv6_gateway": {
                    "pattern": "^[0-9a-fA-F:]{2,39}$",
                    "type": "string",
                    "description": "IPv6 网关"
                },
                "mtu": {
                    "type": "integer",
                    "description": "MTU 设置（最大传输单元）"
                },
                "nameservers": {
                    "items": {
                        "type": "string"
                    },
                    "type": "array",
                    "description": "DNS 服务器列表"
                },
                "bonding_slave": {
                    "$ref": "#/definitions/api.system.v1.BondingSlaveConfig",
                    "additionalProperties": true,
                    "description": "网卡作为 bond 从属配置"
                }
            },
            "additionalProperties": true,
            "type": "object",
            "title": "Network Interface",
            "description": "网络接口配置项"
        },
        "api.system.v1.NodeSelector": {
            "properties": {
                "machine_id": {
                    "type": "string",
                    "description": "机器ID匹配"
                }
            },
            "additionalProperties": true,
            "type": "object",
            "title": "Node Selector",
            "description": "节点选择器"
        }
    }
}