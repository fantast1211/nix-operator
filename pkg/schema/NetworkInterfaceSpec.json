{
    "$schema": "http://json-schema.org/draft-04/schema#",
    "$ref": "#/definitions/NetworkInterfaceSpec",
    "definitions": {
        "NetworkInterfaceSpec": {
            "properties": {
                "name": {
                    "type": "string",
                    "description": "接口名称（如 eth0, enp0s3）"
                },
                "ipv4_address": {
                    "pattern": "^((25[0-5]|2[0-4][0-9]|[01]?[0-9]?[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9]?[0-9])$",
                    "type": "string",
                    "description": "IPv4 地址"
                },
                "ipv6_address": {
                    "pattern": "^[0-9a-fA-F:]{2,39}$",
                    "type": "string",
                    "description": "IPv6 地址"
                },
                "ipv4_gateway": {
                    "pattern": "^((25[0-5]|2[0-4][0-9]|[01]?[0-9]?[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9]?[0-9])$",
                    "type": "string",
                    "description": "IPv4 网关"
                },
                "ipv6_gateway": {
                    "pattern": "^[0-9a-fA-F:]{2,39}$",
                    "type": "string",
                    "description": "IPv6 网关"
                },
                "mtu": {
                    "type": "integer",
                    "description": "MTU 设置（最大传输单元）"
                },
                "nameservers": {
                    "items": {
                        "type": "string"
                    },
                    "type": "array",
                    "description": "DNS 服务器列表"
                }
            },
            "additionalProperties": true,
            "type": "object",
            "title": "Network Interface Spec",
            "description": "网络接口配置项"
        }
    }
}