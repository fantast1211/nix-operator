{
    "$schema": "http://json-schema.org/draft-04/schema#",
    "$ref": "#/definitions/GetNetworkInterfaceResponse",
    "definitions": {
        "GetNetworkInterfaceResponse": {
            "properties": {
                "interface": {
                    "$ref": "#/definitions/xtopus.api.system.v1.NetworkInterface",
                    "additionalProperties": true,
                    "description": "网络接口"
                }
            },
            "additionalProperties": true,
            "type": "object",
            "title": "Get Network Interface Response",
            "description": "获取网络接口响应"
        },
        "xtopus.api.system.v1.IPv4Config": {
            "properties": {
                "address": {
                    "type": "string",
                    "description": "IP 地址和子网掩码，如 192.168.1.100/24"
                },
                "gateway": {
                    "type": "string",
                    "description": "网关地址"
                },
                "dhcp_enabled": {
                    "type": "boolean",
                    "description": "是否启用 DHCP"
                }
            },
            "additionalProperties": true,
            "type": "object",
            "title": "I Pv 4 Config",
            "description": "IPv4 配置"
        },
        "xtopus.api.system.v1.IPv6Config": {
            "properties": {
                "address": {
                    "type": "string",
                    "description": "IPv6 地址和前缀长度，如 2001:db8::1/64"
                },
                "gateway": {
                    "type": "string",
                    "description": "IPv6 网关"
                },
                "slaac_enabled": {
                    "type": "boolean",
                    "description": "是否启用 SLAAC"
                }
            },
            "additionalProperties": true,
            "type": "object",
            "title": "I Pv 6 Config",
            "description": "IPv6 配置"
        },
        "xtopus.api.system.v1.NetworkInterface": {
            "properties": {
                "node_selector": {
                    "$ref": "#/definitions/xtopus.api.system.v1.NodeSelector",
                    "additionalProperties": true,
                    "description": "节点选择器"
                },
                "name": {
                    "type": "string",
                    "description": "接口名称，如 eth0, ens33"
                },
                "ipv4": {
                    "$ref": "#/definitions/xtopus.api.system.v1.IPv4Config",
                    "additionalProperties": true,
                    "description": "IPv4 配置"
                },
                "ipv6": {
                    "$ref": "#/definitions/xtopus.api.system.v1.IPv6Config",
                    "additionalProperties": true,
                    "description": "IPv6 配置"
                },
                "mtu": {
                    "type": "integer",
                    "description": "MTU 大小"
                },
                "mac_address": {
                    "type": "string",
                    "description": "MAC 地址"
                },
                "status": {
                    "enum": [
                        "Unknown",
                        0,
                        "Up",
                        1,
                        "Down",
                        2
                    ],
                    "oneOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "integer"
                        }
                    ],
                    "title": "Interface Status",
                    "description": "接口状态"
                }
            },
            "additionalProperties": true,
            "type": "object",
            "title": "Network Interface",
            "description": "网络接口配置"
        },
        "xtopus.api.system.v1.NodeSelector": {
            "properties": {
                "hostname": {
                    "type": "string",
                    "description": "主机名匹配"
                },
                "mac_address": {
                    "type": "string",
                    "description": "MAC 地址匹配"
                },
                "labels": {
                    "additionalProperties": {
                        "type": "string"
                    },
                    "type": "object",
                    "description": "标签选择器"
                }
            },
            "additionalProperties": true,
            "type": "object",
            "title": "Node Selector",
            "description": "节点选择器"
        }
    }
}