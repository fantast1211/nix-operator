                    "type": "string",
                    "description": "IP地址"
                },
                "hostnames": {
                    "items": {
                        "type": "string"
                    },
                    "type": "array",
                    "description": "主机名列表"
                }
            },
            "additionalProperties": true,
            "type": "object",
            "title": "Host Entry",
