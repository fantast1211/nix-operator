{
    "$schema": "http://json-schema.org/draft-04/schema#",
    "$ref": "#/definitions/IPv6Config",
    "definitions": {
        "IPv6Config": {
            "properties": {
                "address": {
                    "type": "string",
                    "description": "IPv6 地址和前缀长度，如 2001:db8::1/64"
                },
                "gateway": {
                    "type": "string",
