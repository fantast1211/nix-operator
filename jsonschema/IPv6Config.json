                },
                "slaac_enabled": {
                    "type": "boolean",
                    "description": "是否启用 SLAAC"
                }
            },
            "additionalProperties": true,
            "type": "object",
            "title": "I Pv 6 Config",
            "description": "IPv6 配置"
        }
    }
}