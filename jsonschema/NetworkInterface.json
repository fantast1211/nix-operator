{
    "$schema": "http://json-schema.org/draft-04/schema#",
    "$ref": "#/definitions/NetworkInterface",
    "definitions": {
        "NetworkInterface": {
            "properties": {
                "node_selector": {
                    "$ref": "#/definitions/xtopus.api.system.v1.NodeSelector",
                    "additionalProperties": true,
                    "description": "节点选择器（用于定位目标节点）"
                },
                "name": {
                    "type": "string",
                    "description": "接口名称（如 eth0, enp0s3）"
                },
                "ipv4_address": {
                    "type": "string",
                    "description": "IPv4 地址"
                },
                "ipv6_address": {
                    "type": "string",
                    "description": "IPv6 地址"
                },
                "ipv4_gateway": {
                    "type": "string",
                    "description": "IPv4 网关"
                },
                "ipv6_gateway": {
                    "type": "string",
                    "description": "IPv6 网关"
                },
                "mtu": {
                    "type": "integer",
                    "description": "MTU 设置（最大传输单元）"
                },
                "mac_address": {
                    "type": "string",
                    "description": "MAC 地址"
                },
                "nameservers": {
                    "items": {
                        "type": "string"
                    },
                    "type": "array",
                    "description": "DNS 服务器列表"
                }
            },
            "additionalProperties": true,
            "type": "object",
            "title": "网络相关配置定义",
            "description": "网络相关配置定义  网络接口配置项"
        },
        "xtopus.api.system.v1.NodeSelector": {
            "properties": {
                "machine_id": {
                    "type": "string",
                    "description": "机器ID匹配"
                },
                "ip": {
                    "type": "string",
                    "description": "IP地址匹配"
                }
            },
            "additionalProperties": true,
            "type": "object",
            "title": "Node Selector",
            "description": "节点选择器"
        }
    }
}